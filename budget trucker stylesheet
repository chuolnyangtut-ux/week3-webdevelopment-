/* ==========================================================================
Budget Tracker - Visual Identity Stylesheet
========================================================================== */
​/* --------------------------------------------------------------------------
​CSS Custom Properties / Color Palette & Typography
-------------------------------------------------------------------------- /
:root {
/ Color Palette /
--color-bg: #f1f5f9;            / Soft slate background /
--color-card-bg: #ffffff;       / White card background /
--color-text-primary: #1e293b;  / Dark slate for headings & primary text /
--color-text-secondary: #64748b;/ Muted text for subtitles and labels /
--color-primary: #0f766e;       / Deep teal primary brand color /
--color-primary-hover: #115e59; / Darker teal for button hover /
--color-secondary: #e2e8f0;     / Light gray for secondary buttons /
--color-secondary-hover: #cbd5e1;
--color-border: #e2e8f0;        / Subtle divider borders /
--color-row-alt: #f8fafc;       / Alternating table row background */
​/* Custom Typography */
--font-heading: 'Poppins', sans-serif;
--font-body: 'Inter', sans-serif;
​/* Spacing & Borders */
--radius-card: 12px;
--radius-input: 8px;
--shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
--shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
}
​/* --------------------------------------------------------------------------
2. Global Resets & Typography Rules
-------------------------------------------------------------------------- */
​{
box-sizing: border-box;
margin: 0;
padding: 0;
}
​body {
background-color: var(--color-bg);
color: var(--color-text-primary);
font-family: var(--font-body);
font-size: 16px;
line-height: 1.6;
padding: 2.5rem 1rem;
}
​.container {
max-width: 900px;
margin: 0 auto;
}
​h1, h2, h3 {
font-family: var(--font-heading);
color: var(--color-text-primary);
line-height: 1.25;
}
​h1 {
font-size: 2.1rem;
font-weight: 700;
margin-bottom: 0.5rem;
}
​h2 {
font-size: 1.35rem;
font-weight: 600;
margin-bottom: 1.25rem;
border-bottom: 2px solid var(--color-border);
padding-bottom: 0.5rem;
}
​.subtitle {
color: var(--color-text-secondary);
font-size: 0.95rem;
}
​/* --------------------------------------------------------------------------
3. CSS Box Model - Visual Card Containers
-------------------------------------------------------------------------- /
.card {
background-color: var(--color-card-bg);
border: 1px solid var(--color-border);
border-radius: var(--radius-card);
padding: 1.75rem;
margin-bottom: 2rem; / Margin creates separation between card sections */
box-shadow: var(--shadow-card);
transition: box-shadow 0.2s ease, transform 0.2s ease;
}
​.card:hover {
box-shadow: var(--shadow-hover);
}
​.header-card {
text-align: center;
padding: 2.25rem 1.5rem;
}
​/* --------------------------------------------------------------------------
4. Form & Input Styling
-------------------------------------------------------------------------- */
.form-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
gap: 1.25rem;
margin-bottom: 1.5rem;
}
​.form-group {
display: flex;
flex-direction: column;
}
​.form-group label {
font-size: 0.875rem;
font-weight: 500;
color: var(--color-text-secondary);
margin-bottom: 0.4rem;
}
​input[type="text"],
input[type="number"],
input[type="date"],
select {
width: 100%;
padding: 0.65rem 0.85rem;
font-family: var(--font-body);
font-size: 0.95rem;
color: var(--color-text-primary);
background-color: #ffffff;
border: 1px solid var(--color-border);
border-radius: var(--radius-input);
outline: none;
transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
​input:focus,
select:focus {
border-color: var(--color-primary);
box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
}
​.form-actions {
display: flex;
gap: 1rem;
justify-content: flex-end;
}
​/* Button Styling */
.btn {
padding: 0.65rem 1.4rem;
font-family: var(--font-body);
font-weight: 500;
font-size: 0.95rem;
border: none;
border-radius: var(--radius-input);
cursor: pointer;
transition: background-color 0.2s ease, transform 0.1s ease;
}
​.btn-primary {
background-color: var(--color-primary);
color: #ffffff;
}
​.btn-primary:hover {
background-color: var(--color-primary-hover);
}
​.btn-secondary {
background-color: var(--color-secondary);
color: var(--color-text-primary);
}
​.btn-secondary:hover {
background-color: var(--color-secondary-hover);
}
​.btn:active {
transform: translateY(1px);
}
​/* --------------------------------------------------------------------------
5. Expense Table Styling
-------------------------------------------------------------------------- */
.table-wrapper {
overflow-x: auto;
border-radius: var(--radius-input);
border: 1px solid var(--color-border);
}
​.expense-table {
width: 100%;
border-collapse: collapse;
text-align: left;
font-size: 0.95rem;
}
​.expense-table th {
background-color: var(--color-primary);
color: #ffffff;
font-family: var(--font-heading);
font-weight: 600;
padding: 0.85rem 1rem;
}
​.expense-table td {
padding: 0.85rem 1rem;
border-bottom: 1px solid var(--color-border);
}
​/* Alternating Row Styling (Zebra Striping) */
.expense-table tbody tr:nth-child(even) {
background-color: var(--color-row-alt);
}
​.expense-table tbody tr:hover {
background-color: #f1f5f9;
}
​.expense-table tbody tr:last-child td {
border-bottom: none;
}